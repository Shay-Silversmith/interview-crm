# ---------------------------------------------------------------------------
# InterviewFlow — environment variables reference
# Copy this file to .env.local for local development.
# Never commit .env.local — it is git-ignored.
# ---------------------------------------------------------------------------

# ── Supabase (client-side, safe to expose) ───────────────────────────────────

# Your project's REST + auth URL.
# Found in: Supabase → Settings → API → Project URL.
# Required for Supabase mode; leave unset to run in mock/demo mode.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Anonymous (public) API key — RLS policies enforce row-level security.
# Found in: Supabase → Settings → API → Project API keys → anon public.
# Required for Supabase mode.
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Feature flags ────────────────────────────────────────────────────────────

# Set to "true" to enable live AI calls through /api/ai/* serverless functions.
# When "false" or absent all AI tools fall back to deterministic mock responses.
# Optional — default: false
VITE_AI_ENABLED=false

# Email of the admin user; enables demo mode and other admin-only UI.
# Frontend-readable (not a secret) — only decides which user sees admin UI.
# DB-level RLS still enforces user_id isolation regardless of this flag.
VITE_ADMIN_EMAIL=you@example.com

# ── AI backend (Google Gemini, BYOK) ─────────────────────────────────────────
#
# As of p3a the AI backend is Google Gemini. Each user provides their own
# Gemini API key via the in-app Settings UI (Prompt 3b). The key lives in
# the user's browser localStorage and is forwarded to /api/ai/* serverless
# functions as the `x-gemini-api-key` header. The server NEVER stores it.
#
# Therefore: NO server-side AI key env var is required. Just set
# VITE_AI_ENABLED=true above.
#
# Users generate keys at https://aistudio.google.com/app/apikey

# ── Web search for the research tools (server-side, SECRET) ─────────────────
#
# The research tools — company auto-fill, the interview brief, reading a job
# posting from a link — used to search through Gemini's own googleSearch tool.
# That is no longer possible on a free Gemini key: grounding is refused on
# every model such a key can reach, and gemini-2.5-flash, the one model that
# still had a free grounding allowance, is no longer issued to new accounts.
#
# So search now comes from a dedicated provider. This key belongs to whoever
# DEPLOYS the app and is shared by every visitor — unlike the Gemini key,
# which each user brings themselves. Set it in Vercel's project environment,
# never in client-visible VITE_* form.
#
# Set ONE of the three. They are tried in this order:
#
#   EXA_API_KEY           20,000 requests/month free, NO payment method
#                         required — so it cannot run up a bill. Recommended.
#                         Get one at https://exa.ai
#
#   TAVILY_API_KEY        1,000 credits/month free, also no card.
#                         Get one at https://tavily.com
#
#   BRAVE_SEARCH_API_KEY  No free tier since February 2026: $5 of monthly
#                         credit, then the card on file is charged with no
#                         cap. Supported for existing keys; not a default.
#
# Leave all three unset and the non-searching tools still work; the research
# tools say plainly that search is not configured.

EXA_API_KEY=
